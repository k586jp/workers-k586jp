{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-10",
  "assets": {
    "directory": "./assets/",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "routes": [
    {
      "pattern": "k586.jp",
      "custom_domain": true
    }
  ]
}